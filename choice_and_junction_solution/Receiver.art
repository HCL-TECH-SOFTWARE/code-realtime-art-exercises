capsule Receiver {
    service behavior port com~ : Events;
    
    statemachine {
        initial -> TestNumbers.e;
        state TestNumbers {
            entrypoint e;
            state WaitForData, Positive, NotPositive;
            
            e -> WaitForData;
            WaitForData -> isPositive on com.data;
            choice isPositive;
            positive: isPositive -> Positive when `*rtdata > 0`
            `
                Log::out << "Data is positive" << Log::endl;
            `;
            else: isPositive -> NotPositive when `else`
            `
                Log::out << "Data is not positive" << Log::endl;
            `;

            state DoublePositive {
                entry
                `
                    Log::out << "Two positive numbers received" << Log::endl;
                `;
            };
            state PositiveThenNegative {
                entry
                `
                    Log::out << "Positive then negative number received" << Log::endl;
                `;
            };
            junction check;
            Positive -> check on com.data;
            check -> DoublePositive when `*rtdata > 0`;
            check -> PositiveThenNegative when `*rtdata < 0`;
            
            ignored: on com.data;
        };
        reset: TestNumbers -> TestNumbers.e on com.reset
        `
            Log::out << "--- Reset ---" << Log::endl;
        `;
    };
};
